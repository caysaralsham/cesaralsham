# ترويسات أمان لكل صفحات الموقع (Cloudflare Pages)
# frame-ancestors: ما حدا بيقدر يحط صفحاتنا جوّا موقع تاني، إلا موقعنا وبرامج المحاسبة (المرسم بيشتغل جوّاها كمحرك رسم)
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self' https://caysaralsham.github.io

# الأدوات الخاصة: مخفية عن محركات البحث حتى لو وصلها رابط من مكان ما
/my/*
  X-Robots-Tag: noindex, nofollow
/studio-q7m4/*
  X-Robots-Tag: noindex, nofollow
/admin-works*
  X-Robots-Tag: noindex, nofollow
/links/admin-settings*
  X-Robots-Tag: noindex, nofollow
/logo-tool*
  X-Robots-Tag: noindex, nofollow
/qs-home*
  X-Robots-Tag: noindex, nofollow
/home*
  X-Robots-Tag: noindex, nofollow

# مكتبات أداة اللوغو: نسخة ثابتة برقم بالرابط، بتنحفظ بالجهاز سنة كاملة
/my/logo/lib/*
  Cache-Control: public, max-age=31536000, immutable
