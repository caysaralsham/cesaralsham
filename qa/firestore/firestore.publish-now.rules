rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.uid in ["dzrssSkOkqSFAcLpO1JkUROQU0D2", "b9mGtbtfmqRWtW3WDcqL7iBKrig1"];
    }

    match /cesar_website/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /miracos_accounting/{docId} {
      allow read, write: if isOwner();
    }

    match /cesar_accounting_sales/{docId} {
      allow read, write: if isOwner();
    }

    match /cesar_accounting_expenses/{docId} {
      allow read, write: if isOwner();
    }

    // أداة المنشورات (/my/tasweeq): للمالك فقط. النص الأصلي لا يتغير بعد حفظه، ولا حذف
    match /cesar_marketing/{docId} {
      allow read, create: if isOwner();
      allow update: if isOwner() && request.resource.data.original == resource.data.original;
      allow delete: if false;
    }

    // عدّاد «طلب السعر عبر واتساب» (js/wa-count.js): الزائر بيزيد 1 بس — ما بيقرأ ولا بيحذف ولا بيمسح.
    // count = كل الكبسات، uniq = زوار مختلفين (مرة باليوم)، cats = اسم العمل/القسم (مفتاح واحد بكل كبسة)
    match /cesar_price_clicks/{day} {
      allow read: if isOwner();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['date', 'count', 'uniq', 'cats'])
        && request.resource.data.get('date', day) == day
        && request.resource.data.get('count', 0) == 1
        && request.resource.data.get('uniq', 0) is int
        && request.resource.data.get('uniq', 0) >= 0
        && request.resource.data.get('uniq', 0) <= 1
        && request.resource.data.get('cats', {}) is map
        && request.resource.data.get('cats', {}).size() <= 1;
      allow update: if request.resource.data.keys().hasOnly(['date', 'count', 'uniq', 'cats'])
        && request.resource.data.get('date', day) == day
        && request.resource.data.get('count', 0) == resource.data.get('count', 0) + 1
        && request.resource.data.get('uniq', 0) is int
        && request.resource.data.get('uniq', 0) >= resource.data.get('uniq', 0)
        && request.resource.data.get('uniq', 0) <= resource.data.get('uniq', 0) + 1
        && request.resource.data.get('cats', {}) is map
        && request.resource.data.get('cats', {}).size() <= 300
        && request.resource.data.get('cats', {}).diff(resource.data.get('cats', {})).affectedKeys().size() <= 1;
      allow delete: if false;
    }

    match /cesar_stats/{day} {
      allow read: if isOwner();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['date', 'count', 'countries'])
        && request.resource.data.get('count', 0) <= 1;
      allow update: if request.resource.data.keys().hasOnly(['date', 'count', 'countries'])
        && request.resource.data.get('count', 0) >= resource.data.get('count', 0)
        && request.resource.data.get('count', 0) <= resource.data.get('count', 0) + 1;
      allow delete: if false;
    }

  }
}
